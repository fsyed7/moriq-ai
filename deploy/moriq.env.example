# Copy to /etc/moriq.env and restrict it: chmod 640 /etc/moriq.env
# Your public site name, without https://
MORIQ_ALLOWED_HOSTS=moriq.example.com
# Set to 1 only behind a reverse proxy such as Caddy, so password limits see real visitor addresses.
MORIQ_TRUST_PROXY=1
MORIQ_HOME=/var/lib/moriq
MORIQ_PORT=5180
